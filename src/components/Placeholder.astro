---
/**
 * A labelled image placeholder, shown until the client supplies real photos.
 * It says exactly what photo belongs here, so swapping in the real image later
 * is obvious. Designed to still look intentional in the dark layout.
 */
import Icon from './Icon.astro';
import type { IconNameType } from '../config/schema.ts';

export interface Props {
  label: string;
  ratio?: 'video' | 'square' | '4/3' | '3/2' | 'tall';
  icon?: IconNameType;
  light?: boolean;
  class?: string;
}

const { label, ratio = '4/3', icon = 'home', light = false, class: className = '' } = Astro.props;

const ratioMap: Record<string, string> = {
  video: '16 / 9',
  square: '1 / 1',
  '4/3': '4 / 3',
  '3/2': '3 / 2',
  tall: '3 / 4',
};

const base = light
  ? 'bg-brand-on-light/[0.04] text-brand-on-light-muted'
  : 'bg-brand-text/[0.04] text-brand-muted';
---

<div
  class={`relative flex items-center justify-center overflow-hidden ${base} ${className}`}
  style={`aspect-ratio:${ratioMap[ratio]}`}
>
  <!-- hairline frame -->
  <span
    class="pointer-events-none absolute inset-2 border border-dashed"
    style={`border-color:color-mix(in srgb, currentColor 35%, transparent)`}
  ></span>

  <div class="flex flex-col items-center gap-3 px-6 text-center">
    <Icon name={icon} size={30} class="opacity-70" />
    <span class="text-[0.7rem] font-semibold uppercase tracking-[0.18em]">Photo</span>
    <span class="max-w-[14rem] text-sm leading-snug opacity-80">{label}</span>
  </div>
</div>
