---
import BaseLayout from '../layouts/BaseLayout.astro';

export interface Props {
  pageKey: string;
  title: string;
  lastUpdated?: string;
}

const { pageKey, title, lastUpdated } = Astro.props;
---

<BaseLayout pageKey={pageKey}>
  <section class="bg-brand-bg pb-20 pt-32">
    <div class="container-x" style="max-width:48rem">
      <a href="/" class="eyebrow">Back to home</a>
      <h1 class="heading-section mt-5 text-brand-text">{title}</h1>
      {lastUpdated && <p class="mt-3 text-sm text-brand-muted">Last updated: {lastUpdated}</p>}
      <div class="legal-prose mt-10">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-prose :global(h2) {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.35rem;
    color: var(--color-brand-text);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    letter-spacing: 0.01em;
  }
  .legal-prose :global(p),
  .legal-prose :global(li) {
    color: var(--color-brand-muted);
    line-height: 1.75;
  }
  .legal-prose :global(p) {
    margin-bottom: 1rem;
  }
  .legal-prose :global(ul) {
    margin: 0 0 1rem 1.1rem;
    list-style: disc;
  }
  .legal-prose :global(li) {
    margin-bottom: 0.4rem;
  }
  .legal-prose :global(a) {
    color: var(--color-brand-accent);
    text-decoration: underline;
  }
  .legal-prose :global(strong) {
    color: var(--color-brand-text);
  }
</style>
