---
/**
 * Inline SVG icons. One component, no icon font, no runtime dependency.
 *
 * Line icons (Lucide-style) use `stroke="currentColor"`; brand logos
 * (facebook/instagram/google) use `fill="currentColor"`. Icon ids are validated
 * by the `IconName` enum in `src/config/schema.ts`; add a new id in both places.
 */
import type { IconNameType } from '../config/schema.ts';

export interface Props {
  name: IconNameType;
  size?: number;
  class?: string;
  title?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className = '', title, strokeWidth = 2 } = Astro.props;

