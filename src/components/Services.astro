---
import site from '../config/site.config.ts';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const { services } = site;
const pad2 = (n: number) => String(n + 1).padStart(2, '0');
---

<section id="services" class="section-y bg-brand-bg-alt">
  <div class="container-x">
    <SectionHeading
      eyebrow={services.eyebrow}
      heading={services.heading}
      sub={services.subheading}
      class="reveal"
    />

    <div class="mt-12 border-b border-brand-text/10">
      {
        services.items.map((svc, i) => (
          <a href={`/services/${svc.slug}/`} class="svc-row group reveal" aria-label={`${svc.name} -- learn more`}>
            <span class="svc-num">{pad2(i)}</span>

            <span class="min-w-0">
              <span class="flex items-center gap-3">
                <Icon
                  name={svc.icon}
                  size={22}
                  class="shrink-0 text-brand-accent"
                  strokeWidth={2}
                />
                <span class="display text-2xl text-brand-text sm:text-3xl">{svc.name}</span>
              </span>
              <span class="mt-2 block max-w-2xl text-sm text-brand-muted sm:text-[0.95rem]">
                {svc.description}
              </span>
              {
                svc.bullets && (
                  <span class="mt-3 hidden flex-wrap gap-2 sm:flex">
                    {svc.bullets.map((b) => (
                      <span class="border border-brand-text/12 px-2.5 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.08em] text-brand-muted">
                        {b}
                      </span>
                    ))}
                  </span>
                )
              }
            </span>

            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-brand-text/15 text-brand-text/70 transition-colors group-hover:border-brand-accent group-hover:bg-brand-accent group-hover:text-brand-accent-text">
              <Icon name="arrow-right" size={18} />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
