---
/**
 * JSON-LD structured data.
 *  - Always: LocalBusiness (GeneralContractor), with aggregateRating only when
 *    the rating is real and not a placeholder (an unverified rating is fraud).
 *  - Home page (no `service`): FAQPage from the home FAQ.
 *  - Service page (`service` passed): Service + BreadcrumbList + that service's
 *    FAQPage.
 */
import site, { siteUrl } from '../config/site.config.ts';
import type { ServiceItem } from '../config/schema.ts';

export interface Props {
  service?: ServiceItem;
}
const { service } = Astro.props;

const { company, contact, reviews, faq, seo, social } = site;
const abs = (p: string) => new URL(p, siteUrl + '/').href;

const business: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${siteUrl}/#business`,
  name: company.name,
  description: seo.description,
  slogan: company.tagline,
  url: siteUrl,
  image: abs(seo.ogImage),
  telephone: contact.phonePrimary.href,
  email: contact.email,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.addressLine,
    addressLocality: contact.city,
    addressRegion: contact.region,
    postalCode: contact.postalCode,
    addressCountry: 'US',
  },
  areaServed: contact.serviceAreas.map((a) => ({
    '@type': 'City',
    name: `${a}, ${contact.region}`,
  })),
  sameAs: social.filter((s) => !s.unverified).map((s) => s.url),
};

if (reviews.rating !== null && reviews.count !== null && !reviews.arePlaceholders) {
  business.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: reviews.rating.toFixed(1),
    reviewCount: reviews.count,
  };
}

const graphs: Record<string, unknown>[] = [business];

if (service) {
  graphs.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.name,
    serviceType: service.name,
    description: service.shortDescription,
    url: `${siteUrl}/services/${service.slug}/`,
    provider: { '@id': `${siteUrl}/#business` },
    areaServed: contact.serviceAreas.map((a) => ({
      '@type': 'City',
      name: `${a}, ${contact.region}`,
    })),
  });
  graphs.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: service.name,
        item: `${siteUrl}/services/${service.slug}/`,
      },
    ],
  });
  graphs.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: service.faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  });
} else {
  graphs.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  });
}
---

{graphs.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
